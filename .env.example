# Copy this file to .env and fill in the values for whichever sign-ins you want.

# ── Spotify "Sign in with Spotify" (OAuth) ───────────────────────────────
# Create a free app at https://developer.spotify.com/dashboard
#   - App name: anything (e.g. "My Music Analyzer")
#   - Redirect URI: http://127.0.0.1:8000/callback/spotify   (must match EXACTLY)
#   - Which API/SDKs: Web API
# Copy the Client ID and Client Secret here:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback/spotify

# ── YouTube Music "Sign in with YouTube" (OAuth device flow) ─────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   - Create a project, enable the "YouTube Data API v3"
#   - Create Credentials -> OAuth client ID
#   - Application type: "TV and Limited Input devices"
# Copy the Client ID and Client Secret here:
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────
# Last.fm API key for extra genre/tag enrichment (free at https://www.last.fm/api/account/create)
LASTFM_API_KEY=
