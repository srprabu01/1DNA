# Keep the build context small AND guarantee personal data / secrets never land
# in an image layer (defense-in-depth; the Dockerfile only COPYs app/ + static/).
data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
*token*.json

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

.git/
.gitignore
.claude/
.vscode/
.idea/
deepcut/
docs/
*.md
!README.md
*.log
*.csv
Dockerfile
docker-compose.yml
